[Unit]
Description=Polaris probe panel
Documentation=https://github.com/your-name/polaris
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polaris
Group=polaris
WorkingDirectory=/opt/polaris
Environment=POLARIS_HOST=127.0.0.1
Environment=POLARIS_PORT=8787
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/node /opt/polaris/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polaris/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
