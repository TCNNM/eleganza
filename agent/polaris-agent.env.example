# Polaris agent configuration (chmod 600)
# 面板地址（建议 HTTPS 域名）
POLARIS_URL=https://status.example.com
# 与 config.json 中该节点 target.agentKey 保持一致
POLARIS_TOKEN=replace-with-openssl-rand-hex-24

# 上报间隔（秒），最小 5
POLARIS_INTERVAL=20

# 节点显示名，留空则使用 hostname
POLARIS_NODE_NAME=

# 需要检查状态的 systemd 单元 / OpenRC 服务
POLARIS_SERVICES="nginx xray"

# 需要上报的挂载点
POLARIS_MOUNTS="/ /var"

# 只有面板使用自签名证书时才设为 1
POLARIS_INSECURE=0
