[Unit]
Description=Eleganza agent — push server metrics to the probe panel
Documentation=https://github.com/your-name/eleganza
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/eleganza-agent.env
ExecStart=/usr/local/bin/eleganza-agent
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
